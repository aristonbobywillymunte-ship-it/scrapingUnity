FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy

WORKDIR /app

COPY python_scraper/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir redis pydantic pydantic-core playwright

COPY python_scraper/ /app/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python3", "worker_browser.py"]
