FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 scraperuser

COPY python_scraper/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir redis pydantic pydantic-core

COPY python_scraper/ /app/

USER scraperuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python3", "worker_http.py"]
